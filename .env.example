# ─────────────────────────────────────────────────────────────────
#  Environment Variables — Reverse Tunnel
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  NEVER commit .env to git. It is in .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── Your Domain ──────────────────────────────────────────────────
# The base domain. Tunnels will be: <subdomain>.yourdomain.com
# Dashboard will be at: dashboard.yourdomain.com
# CLI connects to: wss://tunnel.yourdomain.com
DOMAIN=yourdomain.com

# ── MongoDB ───────────────────────────────────────────────────────
# Leave as-is if using Docker Compose (mongo service is named "mongo")
MONGODB_URI=mongodb://mongo:27017/tunnel

# ── Server Ports ──────────────────────────────────────────────────
PORT_CONTROL=3001    # WebSocket control plane
PORT_PROXY=4000      # HTTP proxy for tunneled traffic
PORT_API=3002        # Internal API for dashboard

# ── Logging ───────────────────────────────────────────────────────
# Options: debug, info, warn, error
LOG_LEVEL=info

# ── NextAuth.js ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Or online: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=replace-with-a-random-32-char-secret
NEXTAUTH_URL=https://dashboard.yourdomain.com

# ── GitHub OAuth App ──────────────────────────────────────────────
# Create at: https://github.com/settings/developers → New OAuth App
#   Homepage URL:       https://dashboard.yourdomain.com
#   Callback URL:       https://dashboard.yourdomain.com/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ── Cloudflare (used by setup.sh for SSL cert generation only) ────
# Create at: https://dash.cloudflare.com → My Profile → API Tokens
# Permission needed: Zone → DNS → Edit (for your domain only)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
